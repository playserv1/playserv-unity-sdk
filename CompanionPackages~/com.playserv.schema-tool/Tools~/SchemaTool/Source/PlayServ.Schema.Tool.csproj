<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlayServ.Schema.Tool</AssemblyName>
    <RootNamespace>PlayServ.Schema.Tool</RootNamespace>
    <Version>0.3.4</Version>
    <UseAppHost>false</UseAppHost>
    <RollForward>LatestMajor</RollForward>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PlayServRoslynPath Condition="'$(PlayServRoslynPath)' == ''">$(MSBuildToolsPath)/Roslyn/bincore</PlayServRoslynPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(PlayServRoslynPath)/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(PlayServRoslynPath)/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PrunePlayServRuntime" AfterTargets="Publish">
    <ItemGroup>
      <PlayServSatelliteResource Include="$(PublishDir)**/*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(PlayServSatelliteResource)" />
    <Delete Files="$(PublishDir)$(AssemblyName).deps.json" />
  </Target>
</Project>
